@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-5 fw-bold">Welcome to Agreely</h1>
    <p class="lead text-muted">Create groups, make commitments, stay accountable.</p>
    <div class="mt-4">
        <a asp-controller="Group" asp-action="Create" class="btn btn-dark me-2">Create a Group</a>
        <a asp-controller="Group" asp-action="Join" class="btn btn-outline-dark">Join a Group</a>
    </div>
</div>