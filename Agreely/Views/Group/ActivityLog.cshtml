@model Agreely.ViewModels.ActivityLogViewModel

<h2>Activity Log — @Model.GroupName</h2>
<a asp-action="Details" asp-route-groupId="@Model.GroupId" class="btn btn-secondary mb-3">← Back to Group</a>

@if (!Model.Logs.Any())
{
    <p class="text-muted">No activity yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var log in Model.Logs)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span><strong>@log.UserFullName</strong> — @log.Description</span>
                <small class="text-muted">@log.OccuredAt.ToString("dd MMM yyyy HH:mm")</small>
            </li>
        }
    </ul>
}