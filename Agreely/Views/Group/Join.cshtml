@model Agreely.Services.DTO.JoinGroupDto

@{
    ViewData["Title"] = "Join Group";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Join Group</h2>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger">@ViewData["Error"]</div>
        }

        <form method="post" asp-action="Join" asp-controller="Group">
            <div class="mb-3">
                <label class="form-label">Group ID</label>
                <input asp-for="GroupId" class="form-control" />
                <span asp-validation-for="GroupId" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark">Join</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>