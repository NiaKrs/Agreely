@using Agreely.Services.DTO
@model Agreely.Services.DTO.GroupDetailsDto

@{
    ViewData["Title"] = "Group Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">@Model.Name</h2>
    <a asp-action="Create" asp-controller="Commitment" asp-route-groupId="@Model.GroupId" class="btn btn-dark">
        + Add Commitment
    </a>
</div>

<p class="text-muted">@Model.Description</p>
<p><span class="badge bg-secondary">Group ID: @Model.GroupId</span> &nbsp; <span class="badge bg-secondary">Members: @Model.MemberCount</span></p>

<hr />

@if (Model.Commitments.Count == 0)
{
    <p class="text-muted">No commitments yet. Add one above!</p>
}
else
{
    foreach (var commitment in Model.Commitments)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@commitment.Title</h5>
                <p class="card-text text-muted">@commitment.Description</p>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-controller="Commitment" asp-route-id="@commitment.CommitmentId" class="btn btn-sm btn-outline-dark">Edit</a>
                    <form method="post" asp-action="Delete" asp-controller="Commitment">
                        <input type="hidden" name="id" value="@commitment.CommitmentId" />
                        <input type="hidden" name="groupId" value="@Model.GroupId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
}