@using Agreely.Domain.Enums
@model Agreely.ViewModels.GroupDetailsViewModel

@{
    ViewData["Title"] = "Group Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">@Model.Name</h2>
    <a asp-action="Create" asp-controller="Commitment" asp-route-groupId="@Model.GroupId" class="btn btn-dark">
        + Add Commitment
    </a>
    <a asp-action="ActivityLog" asp-route-groupId="@Model.GroupId" class="btn btn-outline-secondary">View Activity Log</a>
</div>

<p class="text-muted">@Model.Description</p>
<p><span class="badge bg-secondary">Group ID: @Model.GroupId</span> &nbsp; <span class="badge bg-secondary">Members: @Model.MemberCount</span></p>

<hr />

@if (Model.Commitments.Count > 0)
{
    <div class="row g-3 mb-4">
        <div class="col-auto">
            <div class="border rounded px-3 py-2 text-center">
                <div class="fs-4 fw-bold text-success">@Model.HealthyCount</div>
                <div class="small text-muted">Healthy</div>
            </div>
        </div>
        <div class="col-auto">
            <div class="border rounded px-3 py-2 text-center">
                <div class="fs-4 fw-bold text-warning">@Model.NeedsAttentionCount</div>
                <div class="small text-muted">Needs Attention</div>
            </div>
        </div>
        <div class="col-auto">
            <div class="border rounded px-3 py-2 text-center">
                <div class="fs-4 fw-bold text-info">@Model.DueForReviewCount</div>
                <div class="small text-muted">Due for Review</div>
            </div>
        </div>
    </div>
}

@if (Model.Commitments.Count == 0)
{
    <p class="text-muted">No commitments yet. Add one above!</p>
}
else
{
    foreach (var commitment in Model.Commitments)
    {
        <div class="card mb-3" id="commitment-@commitment.CommitmentId">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title">
                    @if (commitment.Status == CommitmentStatus.Active)
                    {
                        <span class="text-success">Agreement</span>
                    }
                    else
                    {
                        <span>Commitment</span>
                    }
                    — @commitment.Title

                </h5>

                @if (commitment.HealthStatus == HealthStatusValue.NeedsAttention)
                {
                    <span class="badge bg-warning text-dark mb-2">Needs Attention</span>
                }
                else if (commitment.HealthStatus == HealthStatusValue.DueForReview)
                {
                    <span class="badge bg-info text-dark mb-2">Due for Review</span>
                }
                else
                {
                    <span class="badge bg-success mb-2">Healthy</span>
                }
				</div>


                <p class="card-text text-muted">@commitment.Description</p>

                @if (commitment.UserVote.HasValue)
                {
                    <p class="mb-2">
                        <small class="text-muted">
                            Your vote:
                            <strong>@commitment.UserVote.Value</strong>
                        </small>
                    </p>
                }

                <div class="d-flex gap-2 mt-2">
                    <a asp-action="Edit" asp-controller="Commitment" asp-route-id="@commitment.CommitmentId" asp-route-groupId="@Model.GroupId" class="btn btn-sm btn-outline-dark">Edit</a>
                    <form method="post" asp-action="Delete" asp-controller="Commitment">
                        <input type="hidden" name="id" value="@commitment.CommitmentId" />
                        <input type="hidden" name="groupId" value="@Model.GroupId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                    @if (commitment.HealthStatus == HealthStatusValue.DueForReview)
                    {
                        <form method="post" asp-action="RequestReview" asp-controller="Commitment">
                            <input type="hidden" name="commitmentId" value="@commitment.CommitmentId" />
                            <input type="hidden" name="groupId" value="@Model.GroupId" />
                            <button type="submit" class="btn btn-sm btn-outline-info">Request Review</button>
                        </form>
                    }
                </div>

                <form method="post" asp-action="Vote" asp-controller="Commitment" class="d-flex gap-2 mt-2">
                    <input type="hidden" name="CommitmentVersionId" value="@commitment.CommitmentVersionId" />
                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                    <input type="hidden" name="CommitmentId" value="@commitment.CommitmentId" />
                    <button type="submit" name="Vote" value="2" class="btn btn-sm @(commitment.UserVote?.ToString() == "Agree" ? "btn-success" : "btn-outline-success")">Agree</button>
                    <button type="submit" name="Vote" value="1" class="btn btn-sm @(commitment.UserVote?.ToString() == "Neutral" ? "btn-secondary" : "btn-outline-secondary")">Neutral</button>
                    <button type="submit" name="Vote" value="0" class="btn btn-sm @(commitment.UserVote?.ToString() == "Disagree" ? "btn-danger" : "btn-outline-danger")">Disagree</button>
                </form>

                @if (commitment.Status == CommitmentStatus.Active)
                {
                    <span class="badge bg-success">Active Agreement</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Pending Commitment</span>
                }
                <div class="d-flex gap-3 mt-2">
                    <small class="text-success">@commitment.VoteCount.Agree Agree</small>
                    <small class="text-secondary">@commitment.VoteCount.Neutral Neutral</small>
                    <small class="text-danger">@commitment.VoteCount.Disagree Disagree</small>
                </div>
            </div>
        </div>
    }
}