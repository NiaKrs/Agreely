@using Agreely.Services.DTO
@model Agreely.Services.DTO.GroupDetailsDto

@{
    ViewData["Title"] = "Group Details";
}

<h2>Group Details</h2>

<a asp-action="Create" asp-controller="Commitment" asp-route-groupId="@Model.GroupId">Add Commitment</a>

<p><strong>Group Name:</strong> @Model.Name</p>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Group ID:</strong> @Model.GroupId</p>
<p><strong>Members:</strong> @Model.MemberCount</p>

<hr />

@if (Model.Commitments.Count == 0)
{
    <p>No commitments yet.</p>
}
else
{
    foreach (var commitment in Model.Commitments)
    {
        <div>
            <p><strong>@commitment.Title</strong></p>
            <p>@commitment.Description</p>
            <a asp-action="Edit" asp-controller="Commitment" asp-route-id="@commitment.CommitmentId">Edit</a>
            <a asp-action="Delete" asp-controller="Commitment" asp-route-id="@commitment.CommitmentId">Delete</a>
        </div>
        <hr />
    }
}