@model Agreely.ViewModels.CreateGroupViewModel

@{
    ViewData["Title"] = "Create Group";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Create Group</h2>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger">@ViewData["Error"]</div>
        }

        <form method="post" asp-action="Create" asp-controller="Group">
            <div class="mb-3">
                <label class="form-label">Group Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark">Create</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>