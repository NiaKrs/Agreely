@model Agreely.Services.DTO.CreateCommitmentDto

@{
    ViewData["Title"] = "Add Commitment";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">Add Commitment</h2>

        @if (ViewData["Error"] != null)
        {
            <div class="alert alert-danger">@ViewData["Error"]</div>
        }

        <form method="post" asp-action="Create" asp-controller="Commitment">
            <input type="hidden" asp-for="GroupId" />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-dark">Save</button>
                <a asp-controller="Group" asp-action="Details" asp-route-groupId="@Model.GroupId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>