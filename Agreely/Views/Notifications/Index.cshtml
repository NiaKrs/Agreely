@using Agreely.Domain.Enums
@model List<Agreely.Services.DTO.Responses.NotificationResponse>

@{
    ViewData["Title"] = "Notifications";
}

<h2>Notifications</h2>

@if (!Model.Any())
{
    <p class="text-muted">You have no notifications.</p>
}
else
{
    foreach (var n in Model)
    {
        <div class="card mb-2 @(n.IsRead ? "" : "border-warning")">
            <div class="card-body d-flex justify-content-between align-items-start">
                <a asp-controller="Notifications"
                   asp-action="Open"
                   asp-route-notificationId="@n.NotificationId"
                   class="text-decoration-none text-reset flex-grow-1">
                    <div>
                        @if (n.HealthStatus == HealthStatusValue.NeedsAttention)
                        {
                            <span class="badge bg-warning text-dark me-2">Needs Attention</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark me-2">Due for Review</span>
                        }
                        <span>@n.Message</span>
                        <br />
                        <small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                    </div>
                </a>
                @if (!n.IsRead)
                {
                    <form method="post" asp-action="MarkAsRead" asp-controller="Notifications" class="ms-2">
                        <input type="hidden" name="notificationId" value="@n.NotificationId" />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark as read</button>
                    </form>
                }
            </div>
        </div>
    }
}